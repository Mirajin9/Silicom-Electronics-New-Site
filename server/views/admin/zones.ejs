<%- include('_head', { title:'Shipping zones', active:'zones', csrf }) %>
<h1>Shipping zones</h1>
<p class="muted" style="margin-top:-8px">Flat shipping rate per zone, matched by the leading digits of the destination pincode (longest match wins). Set a free-shipping threshold per zone (0 = never free). Keep one zone marked default as the fallback for unmatched pincodes.</p>

<% zones.forEach(function(z){ %>
<div class="card">
  <form method="post" action="/admin/zones/<%= z.id %>/update">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row3">
      <div><label>Zone name</label><input name="name" value="<%= z.name %>"></div>
      <div><label>Pincode prefixes <span class="muted">(CSV)</span></label><input name="pincode_prefixes" value="<%= z.pincode_prefixes %>" placeholder="11,12,201"></div>
      <div><label>Flat rate (₹)</label><input name="flat_rate" type="number" step="0.01" value="<%= z.flat_rate %>"></div>
    </div>
    <div class="row">
      <div><label>Free above (₹)</label><input name="free_above" type="number" step="0.01" value="<%= z.free_above %>"></div>
      <div><label>&nbsp;</label><label class="muted" style="font-weight:500"><input type="checkbox" name="is_default" style="width:auto" <%= z.is_default?'checked':'' %>> Default fallback zone</label></div>
    </div>
    <div style="display:flex;gap:10px;margin-top:14px">
      <button class="btn sm">Save changes</button>
  </form>
      <form method="post" action="/admin/zones/<%= z.id %>/delete" class="inline" onsubmit="return confirm('Delete this zone?')">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn danger sm">Delete zone</button>
      </form>
    </div>
</div>
<% }) %>

<div class="card" style="border:1px dashed var(--teal)">
  <h3 style="margin-top:0">Add a new zone</h3>
  <form method="post" action="/admin/zones">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row3">
      <div><label>Zone name</label><input name="name" required></div>
      <div><label>Pincode prefixes <span class="muted">(CSV)</span></label><input name="pincode_prefixes" placeholder="11,12,201"></div>
      <div><label>Flat rate (₹)</label><input name="flat_rate" type="number" step="0.01" value="0"></div>
    </div>
    <div class="row">
      <div><label>Free above (₹)</label><input name="free_above" type="number" step="0.01" value="0"></div>
      <div><label>&nbsp;</label><label class="muted" style="font-weight:500"><input type="checkbox" name="is_default" style="width:auto"> Use as default fallback zone</label></div>
    </div>
    <button class="btn" style="margin-top:14px">Add zone</button>
  </form>
</div>
<%- include('_foot') %>
