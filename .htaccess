# Caching for Hostinger (Apache). GitHub Pages ignores this file.
# Hashed build files never change (a new build gets new names): cache for a year.
# Images and models: 7 days (some keep their name when updated). HTML: always revalidate, so new builds show at once.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|png|jpe?g|svg|glb|pdf|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json model/gltf-binary
</IfModule>
